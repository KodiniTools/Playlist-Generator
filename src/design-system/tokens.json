{
  "$name": "Playlist Generator",
  "$version": "1.0.0",
  "$description": "Design Tokens des Playlist Generators, extrahiert aus src/assets/main.css und den Vue-Komponenten. Laufzeit-Quelle für die App ist tokens.css im selben Ordner; dieses JSON ist die maschinenlesbare Fassung (Format angelehnt an die W3C Design Tokens Community Group). $extensions.css nennt die zugehörige CSS Custom Property.",
  "color": {
    "dark": {
      "bg": {
        "$type": "color",
        "$value": "#091428",
        "$description": "Body-Gradient (Start), Hintergrund der App",
        "$extensions": { "css": "--bg-color" }
      },
      "bgSecondary": {
        "$type": "color",
        "$value": "#0e1c32",
        "$description": "Body-Gradient (Ende), Mobile-Menü",
        "$extensions": { "css": "--bg-secondary" }
      },
      "text": {
        "$type": "color",
        "$value": "#f9f2d5",
        "$description": "Fließtext, Labels, Titel",
        "$extensions": { "css": "--text-color" }
      },
      "accent": {
        "$type": "color",
        "$value": "#c9984d",
        "$description": "Akzent: Section-Titles, Links, Fokus, Hover, Gradient-Start",
        "$extensions": { "css": "--accent-color" }
      },
      "accentSecondary": {
        "$type": "color",
        "$value": "#014f99",
        "$description": "Gradient-Ende, Save-Button",
        "$extensions": { "css": "--accent-secondary" }
      },
      "accentText": {
        "$type": "color",
        "$value": "#091428",
        "$description": "Text auf Gradient-Buttons, Badges, aktiven Tabs",
        "$extensions": { "css": "--accent-text-color" }
      },
      "panel": {
        "$type": "color",
        "$value": "#142640",
        "$description": "Form-/Output-Section, Toast, Stats-Bar, Dialog",
        "$extensions": { "css": "--panel-color" }
      },
      "button": {
        "$type": "color",
        "$value": "#0e1c32",
        "$description": "Copy-Button, Player-Buttons, FAQ-Summary",
        "$extensions": { "css": "--btn-color" }
      },
      "border": {
        "$type": "color",
        "$value": "#2a4a6a",
        "$description": "Alle Rahmen und Trennlinien",
        "$extensions": { "css": "--border-color" }
      },
      "input": {
        "$type": "color",
        "$value": "#0e1c32",
        "$description": "Inputs, Code-Viewer, Segmented Controls, Queue",
        "$extensions": { "css": "--input-bg" }
      },
      "muted": {
        "$type": "color",
        "$value": "#7a8da0",
        "$description": "Untertitel, Captions, Nav-Links, Icons",
        "$extensions": { "css": "--muted-color" }
      },
      "shadow": {
        "$type": "color",
        "$value": "rgba(201, 152, 77, 0.15)",
        "$description": "Schattenfarbe für Panels und Button-Hover",
        "$extensions": { "css": "--shadow-color" }
      },
      "glow": {
        "$type": "color",
        "$value": "rgba(201, 152, 77, 0.3)",
        "$description": "Fokus-Ring, Hover-Glow, Titel-Text-Shadow",
        "$extensions": { "css": "--glow-color" }
      },
      "success": {
        "$type": "color",
        "$value": "#7dd87d",
        "$description": "Toast success",
        "$extensions": { "css": "--success-color" }
      },
      "warning": {
        "$type": "color",
        "$value": "#c9984d",
        "$description": "Important-Notice, Format-Hinweis",
        "$extensions": { "css": "--warning-color" }
      },
      "error": {
        "$type": "color",
        "$value": "#e57373",
        "$description": "Toast error, Clear-Button, Delete-Icon-Hover",
        "$extensions": { "css": "--error-color" }
      }
    },
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#f5f4d6",
        "$description": "Body-Gradient (Start), Hintergrund der App",
        "$extensions": { "css": "--bg-color" }
      },
      "bgSecondary": {
        "$type": "color",
        "$value": "#f0edbe",
        "$description": "Body-Gradient (Ende), Mobile-Menü",
        "$extensions": { "css": "--bg-secondary" }
      },
      "text": {
        "$type": "color",
        "$value": "#003971",
        "$description": "Fließtext, Labels, Titel",
        "$extensions": { "css": "--text-color" }
      },
      "accent": {
        "$type": "color",
        "$value": "#014f99",
        "$description": "Akzent: Section-Titles, Links, Fokus, Hover, Gradient-Start",
        "$extensions": { "css": "--accent-color" }
      },
      "accentSecondary": {
        "$type": "color",
        "$value": "#003971",
        "$description": "Gradient-Ende, zugleich Textfarbe",
        "$extensions": { "css": "--accent-secondary" }
      },
      "accentText": {
        "$type": "color",
        "$value": "#f5f4d6",
        "$description": "Text auf Gradient-Buttons, Badges, aktiven Tabs",
        "$extensions": { "css": "--accent-text-color" }
      },
      "panel": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Form-/Output-Section, Toast, Dialog",
        "$extensions": { "css": "--panel-color" }
      },
      "button": {
        "$type": "color",
        "$value": "#f8e1a9",
        "$description": "Copy-Button, Player-Buttons, FAQ-Summary",
        "$extensions": { "css": "--btn-color" }
      },
      "border": {
        "$type": "color",
        "$value": "#c9984d",
        "$description": "Alle Rahmen und Trennlinien (Gold statt Grau)",
        "$extensions": { "css": "--border-color" }
      },
      "input": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Inputs, Code-Viewer, Segmented Controls, Queue",
        "$extensions": { "css": "--input-bg" }
      },
      "muted": {
        "$type": "color",
        "$value": "#3d6080",
        "$description": "Untertitel, Captions, Nav-Links, Icons",
        "$extensions": { "css": "--muted-color" }
      },
      "shadow": {
        "$type": "color",
        "$value": "rgba(1, 79, 153, 0.15)",
        "$description": "Schattenfarbe für Panels und Button-Hover",
        "$extensions": { "css": "--shadow-color" }
      },
      "glow": {
        "$type": "color",
        "$value": "rgba(1, 79, 153, 0.25)",
        "$description": "Fokus-Ring, Hover-Glow, Titel-Text-Shadow",
        "$extensions": { "css": "--glow-color" }
      },
      "success": {
        "$type": "color",
        "$value": "#4caf50",
        "$description": "Toast success",
        "$extensions": { "css": "--success-color" }
      },
      "warning": {
        "$type": "color",
        "$value": "#c9984d",
        "$description": "Important-Notice",
        "$extensions": { "css": "--warning-color" }
      },
      "error": {
        "$type": "color",
        "$value": "#d32f2f",
        "$description": "Toast error, Delete-Icon-Hover",
        "$extensions": { "css": "--error-color" }
      }
    }
  },
  "ssi": {
    "$description": "Spiegel-Variablen für die SSI-Partials (nav.html, footer.html, cookie-banner.html). In der Vue-App nicht verwenden, dort gelten die color-Tokens.",
    "dark": {
      "primary": {
        "$type": "color",
        "$value": "#014f99",
        "$extensions": { "css": "--color-primary" }
      },
      "bg": { "$type": "color", "$value": "#091428", "$extensions": { "css": "--color-bg" } },
      "bgSecondary": {
        "$type": "color",
        "$value": "#0e1c32",
        "$extensions": { "css": "--color-bg-secondary" }
      },
      "bgGradient": {
        "$type": "color",
        "$value": "#091428",
        "$extensions": { "css": "--color-bg-gradient" }
      },
      "text": { "$type": "color", "$value": "#f9f2d5", "$extensions": { "css": "--color-text" } },
      "textLight": {
        "$type": "color",
        "$value": "#f8e1a9",
        "$extensions": { "css": "--color-text-light" }
      },
      "textMuted": {
        "$type": "color",
        "$value": "#7a8da0",
        "$extensions": { "css": "--color-text-muted" }
      },
      "border": {
        "$type": "color",
        "$value": "#1c3a5e",
        "$extensions": { "css": "--color-border" }
      },
      "accent": {
        "$type": "color",
        "$value": "#c9984d",
        "$extensions": { "css": "--color-accent" }
      },
      "accentLight": {
        "$type": "color",
        "$value": "#f8e1a9",
        "$extensions": { "css": "--color-accent-light" }
      },
      "white": { "$type": "color", "$value": "#142640", "$extensions": { "css": "--color-white" } },
      "success": {
        "$type": "color",
        "$value": "#50e3c2",
        "$extensions": { "css": "--color-success" }
      },
      "warning": {
        "$type": "color",
        "$value": "#f8e71c",
        "$extensions": { "css": "--color-warning" }
      },
      "error": { "$type": "color", "$value": "#f44336", "$extensions": { "css": "--color-error" } },
      "info": { "$type": "color", "$value": "#2196f3", "$extensions": { "css": "--color-info" } },
      "shadowSm": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(0, 0, 0, 0.2)",
        "$extensions": { "css": "--shadow-sm" }
      },
      "shadowMd": {
        "$type": "shadow",
        "$value": "0 4px 6px rgba(0, 0, 0, 0.3)",
        "$extensions": { "css": "--shadow-md" }
      },
      "transitionBase": {
        "$type": "transition",
        "$value": "0.2s ease",
        "$extensions": { "css": "--transition-base" }
      },
      "externalNavHeight": {
        "$type": "dimension",
        "$value": "50px",
        "$description": "Höhe der externen SSI-Navigation; App.vue misst den realen Wert nach und überschreibt die Variable auf <html>",
        "$extensions": { "css": "--external-nav-height" }
      }
    },
    "light": {
      "primary": {
        "$type": "color",
        "$value": "#014f99",
        "$extensions": { "css": "--color-primary" }
      },
      "bg": { "$type": "color", "$value": "#ffffff", "$extensions": { "css": "--color-bg" } },
      "bgSecondary": {
        "$type": "color",
        "$value": "#f9f2d5",
        "$extensions": { "css": "--color-bg-secondary" }
      },
      "bgGradient": {
        "$type": "color",
        "$value": "#f5f4d6",
        "$extensions": { "css": "--color-bg-gradient" }
      },
      "text": { "$type": "color", "$value": "#212529", "$extensions": { "css": "--color-text" } },
      "textLight": {
        "$type": "color",
        "$value": "#6c757d",
        "$extensions": { "css": "--color-text-light" }
      },
      "textMuted": {
        "$type": "color",
        "$value": "#adb5bd",
        "$extensions": { "css": "--color-text-muted" }
      },
      "border": {
        "$type": "color",
        "$value": "#dee2e6",
        "$extensions": { "css": "--color-border" }
      },
      "accent": {
        "$type": "color",
        "$value": "#c9984d",
        "$extensions": { "css": "--color-accent" }
      },
      "accentLight": {
        "$type": "color",
        "$value": "#f8e1a9",
        "$extensions": { "css": "--color-accent-light" }
      },
      "white": { "$type": "color", "$value": "#ffffff", "$extensions": { "css": "--color-white" } },
      "success": {
        "$type": "color",
        "$value": "#50e3c2",
        "$extensions": { "css": "--color-success" }
      },
      "warning": {
        "$type": "color",
        "$value": "#f8e71c",
        "$extensions": { "css": "--color-warning" }
      },
      "error": { "$type": "color", "$value": "#f44336", "$extensions": { "css": "--color-error" } },
      "info": { "$type": "color", "$value": "#2196f3", "$extensions": { "css": "--color-info" } },
      "shadowSm": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(0, 0, 0, 0.05)",
        "$extensions": { "css": "--shadow-sm" }
      },
      "shadowMd": {
        "$type": "shadow",
        "$value": "0 4px 6px rgba(0, 0, 0, 0.1)",
        "$extensions": { "css": "--shadow-md" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "base": {
        "$type": "fontFamily",
        "$value": "'Supreme', sans-serif",
        "$description": "Supreme Regular 400 (Fontshare / ITF), geladen aus /fonts/Supreme-Regular.woff2 mit font-display swap. Gewichte 500–700 sind nicht als Dateien vorhanden und werden vom Browser synthetisiert.",
        "$extensions": { "css": "--font-family-base" }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'Courier New', monospace",
        "$description": "Code-Viewer, Textarea, Code-Badges",
        "$extensions": { "css": "--font-family-mono" }
      }
    },
    "fontSize": {
      "base": {
        "$type": "dimension",
        "$value": "15px",
        "$description": "Wurzelgröße (body), Basis der rem-Skala",
        "$extensions": { "css": "--font-size-base" }
      },
      "hero": {
        "$type": "dimension",
        "$value": "3.5rem",
        "$description": ".hero-title (LandingPage), Gradient-Text",
        "$extensions": { "css": "--font-size-hero" }
      },
      "pageTitle": {
        "$type": "dimension",
        "$value": "3rem",
        "$description": "main.css header h1 (Legacy)",
        "$extensions": { "css": "--font-size-page-title" }
      },
      "sectionHeadline": {
        "$type": "dimension",
        "$value": "2.5rem",
        "$description": ".section-header h2",
        "$extensions": { "css": "--font-size-section-headline" }
      },
      "heroSubtitle": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": ".hero-subtitle",
        "$extensions": { "css": "--font-size-hero-subtitle" }
      },
      "appTitle": {
        "$type": "dimension",
        "$value": "1.35rem",
        "$description": "AppPage h1",
        "$extensions": { "css": "--font-size-app-title" }
      },
      "cardTitle": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$description": ".tool-card h3, .feature-card h3",
        "$extensions": { "css": "--font-size-card-title" }
      },
      "lead": {
        "$type": "dimension",
        "$value": "1.1rem",
        "$description": ".hero-description, .description p",
        "$extensions": { "css": "--font-size-lead" }
      },
      "body": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "Inputs, Buttons, Fließtext",
        "$extensions": { "css": "--font-size-body" }
      },
      "label": {
        "$type": "dimension",
        "$value": "0.9rem",
        "$description": ".form-group label, .copy-button",
        "$extensions": { "css": "--font-size-label" }
      },
      "code": {
        "$type": "dimension",
        "$value": "0.82rem",
        "$description": ".code-content, .format-tab",
        "$extensions": { "css": "--font-size-code" }
      },
      "caption": {
        "$type": "dimension",
        "$value": "0.8rem",
        "$description": ".format-desc, .format-notice, .history-btn",
        "$extensions": { "css": "--font-size-caption" }
      },
      "sectionTitle": {
        "$type": "dimension",
        "$value": "0.72rem",
        "$description": ".section-title (Versalien)",
        "$extensions": { "css": "--font-size-section-title" }
      },
      "badge": {
        "$type": "dimension",
        "$value": "0.68rem",
        "$description": ".code-lang-badge",
        "$extensions": { "css": "--font-size-badge" }
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$extensions": { "css": "--font-weight-regular" }
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$extensions": { "css": "--font-weight-medium" }
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$extensions": { "css": "--font-weight-semibold" }
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$extensions": { "css": "--font-weight-bold" }
      }
    },
    "lineHeight": {
      "base": {
        "$type": "number",
        "$value": 1.6,
        "$description": "body",
        "$extensions": { "css": "--line-height-base" }
      },
      "tight": {
        "$type": "number",
        "$value": 1.25,
        "$description": "Segmented-Buttons",
        "$extensions": { "css": "--line-height-tight" }
      },
      "code": {
        "$type": "number",
        "$value": 1.65,
        "$description": ".code-content",
        "$extensions": { "css": "--line-height-code" }
      },
      "lead": {
        "$type": "number",
        "$value": 1.8,
        "$description": ".hero-description",
        "$extensions": { "css": "--line-height-lead" }
      }
    },
    "letterSpacing": {
      "sectionTitle": {
        "$type": "dimension",
        "$value": "0.1em",
        "$description": ".section-title, .code-lang-badge",
        "$extensions": { "css": "--letter-spacing-section-title" }
      },
      "tab": {
        "$type": "dimension",
        "$value": "0.04em",
        "$description": ".format-tab",
        "$extensions": { "css": "--letter-spacing-tab" }
      },
      "label": {
        "$type": "dimension",
        "$value": "0.01em",
        "$description": ".form-group label, .copy-button",
        "$extensions": { "css": "--letter-spacing-label" }
      },
      "tight": {
        "$type": "dimension",
        "$value": "-0.01em",
        "$description": "AppPage h1",
        "$extensions": { "css": "--letter-spacing-tight" }
      }
    }
  },
  "spacing": {
    "$description": "Gemischte 4er- und 5er-Schritte, so wie im Code verwendet. Schlüssel = Pixelwert.",
    "3": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "Innenabstand Segmented Controls",
      "$extensions": { "css": "--space-3" }
    },
    "4": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "kbd-Gap",
      "$extensions": { "css": "--space-4" }
    },
    "6": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Icon-Gap, History-Buttons",
      "$extensions": { "css": "--space-6" }
    },
    "8": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Label-Abstand, kleine Gaps",
      "$extensions": { "css": "--space-8" }
    },
    "10": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Dropzone-Buttons, Logo-Gap",
      "$extensions": { "css": "--space-10" }
    },
    "12": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Button-Row, kleine Grid-Gaps",
      "$extensions": { "css": "--space-12" }
    },
    "15": {
      "$type": "dimension",
      "$value": "15px",
      "$description": "Input-Padding, Notice-Gap",
      "$extensions": { "css": "--space-15" }
    },
    "16": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Toast-Padding",
      "$extensions": { "css": "--space-16" }
    },
    "20": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Container-Seitenrand, Summary-Padding",
      "$extensions": { "css": "--space-20" }
    },
    "24": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Panel-Padding",
      "$extensions": { "css": "--space-24" }
    },
    "30": {
      "$type": "dimension",
      "$value": "30px",
      "$description": "Grid-Gap, Section-Abstand",
      "$extensions": { "css": "--space-30" }
    },
    "40": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Header-Abstand, Container-Padding oben",
      "$extensions": { "css": "--space-40" }
    },
    "50": {
      "$type": "dimension",
      "$value": "50px",
      "$description": "Section-Abstand groß, Footer",
      "$extensions": { "css": "--space-50" }
    }
  },
  "radius": {
    "badge": {
      "$type": "dimension",
      "$value": "5px",
      "$description": "kbd",
      "$extensions": { "css": "--radius-badge" }
    },
    "chip": {
      "$type": "dimension",
      "$value": "6px",

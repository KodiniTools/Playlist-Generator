    },
    "segment": {
      "$type": "dimension",
      "$value": "7px",
      "$description": "Tab innerhalb eines Segmented Controls",
      "$extensions": { "css": "--radius-segment" }
    },
    "control": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Kleine Buttons, Nav-Pill, Stats-Bar, Format-Notice",
      "$extensions": { "css": "--radius-control" }
    },
    "segmented": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Segmented-Container, Copy-/Save-Button",
      "$extensions": { "css": "--radius-segmented" }
    },
    "input": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Inputs, Toast, Code-Viewer, Card-Button, Queue",
      "$extensions": { "css": "--radius-input" }
    },
    "dropzone": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Dropzone, Preview-Window",
      "$extensions": { "css": "--radius-dropzone" }
    },
    "buttonLg": {
      "$type": "dimension",
      "$value": "15px",
      "$description": "Generate-Button, Important-Notice",
      "$extensions": { "css": "--radius-button-lg" }
    },
    "panel": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Form-/Output-Section, Onboarding",
      "$extensions": { "css": "--radius-panel" }
    },
    "dialog": {
      "$type": "dimension",
      "$value": "18px",
      "$description": "Shortcuts-Dialog",
      "$extensions": { "css": "--radius-dialog" }
    },
    "card": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Tool-Card, Feature-Card, Description",
      "$extensions": { "css": "--radius-card" }
    },
    "cta": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "CTA-Box",

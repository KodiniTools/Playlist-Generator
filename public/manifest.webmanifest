{
  "id": "/playlist_generator/",
  "name": "KodiniTools Playlist Generator",
  "short_name": "Playlist",
  "description": "M3U, PLS, XSPF, JSON and CSV playlists from your audio files, locally in the browser.",
  "start_url": "/playlist_generator/app",
  "scope": "/playlist_generator/",
  "display": "standalone",
  "background_color": "#0a1324",
  "theme_color": "#0a1324",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "/playlist_generator/app",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/flac": [".flac"],
        "audio/x-mpegurl": [".m3u", ".m3u8"],
        "audio/x-scpls": [".pls"],
        "application/xspf+xml": [".xspf"]
      }
    }
  ],
  "launch_handler": { "client_mode": "navigate-existing" }
}

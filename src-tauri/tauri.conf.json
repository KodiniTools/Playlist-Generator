{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playlist Generator",
  "mainBinaryName": "playlist-generator",
  "version": "../package.json",
  "identifier": "com.kodinitools.playlistgenerator",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "KodiniTools",
    "homepage": "https://kodinitools.com/playlist_generator/",
    "copyright": "© KodiniTools",
    "category": "Music",
    "shortDescription": "Wiedergabelisten (M3U, XSPF, JSON …) aus MP3, WAV und FLAC erstellen",
    "longDescription": "Audio Wiedergabeliste Generator von KodiniTools: Wiedergabelisten aus MP3-, WAV- und FLAC-Dateien erstellen, sortieren, anhören und als M3U, M3U8, PLS, XSPF, CUE, CSV, JSON, TXT, Markdown oder YouTube-Kapitel speichern. Die Verarbeitung läuft lokal auf dem Rechner.",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["de-DE", "en-US"]
      }
    }
  }
}
